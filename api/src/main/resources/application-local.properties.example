spring.application.name=api

spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/usinometria}
spring.datasource.username=${DB_USER:usinometria_app}
spring.datasource.password=${DB_PASSWORD:exemplo}
spring.datasource.driver-class-name=${DB_DRIVER:org.postgresql.Driver}

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration